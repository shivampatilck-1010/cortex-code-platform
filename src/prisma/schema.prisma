// Universal Online Coding Platform - PostgreSQL Production Schema
// 24 Normalized Tables with Foreign Keys, Constraints, Enums, and Indexes

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  PRO_DEVELOPER
  TEAM_ADMIN
  PLATFORM_ADMIN
}

enum ProjectVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ExecutionStatus {
  SUCCESS
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIMEOUT
  MEMORY_LIMIT_EXCEEDED
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionVerdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
}

// 1. users
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String?
  role          UserRole  @default(USER)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  projects      Project[]
  memberships   ProjectMember[]
  submissions   Submission[]
  progress      UserProgress[]
  aiRequests    AIRequest[]
  apiKeys       ApiKey[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([username])
}

// 2. profiles
model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  githubUrl      String?
  websiteUrl     String?
  ratingScore    Int      @default(1200)
  solvedCount    Int      @default(0)
  streakDays     Int      @default(0)
  themePreference String  @default("vs-dark")
  fontSize       Int      @default(14)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 3. projects
model Project {
  id           String            @id @default(uuid())
  title        String
  description  String?
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  visibility   ProjectVisibility @default(PUBLIC)
  defaultLang  String            @default("python")
  isTemplate   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  files        ProjectFile[]
  members      ProjectMember[]
  executions   Execution[]
  deployments  Deployment[]
  sharedLinks  SharedLink[]

  @@index([ownerId])
  @@index([visibility])
}

// 4. project_files
model ProjectFile {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  path        String
  content     String   @db.Text
  isFolder    Boolean  @default(false)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}

// 5. project_members
model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("editor") // viewer, editor, admin
  createdAt  DateTime @default(now())

  @@unique([projectId, userId])
}

// 6. languages
model Language {
  id          String            @id
  name        String            @unique
  slug        String            @unique
  monacoLang  String
  extension   String
  isActive    Boolean           @default(true)
  versions    LanguageVersion[]

  @@index([isActive])
}

// 7. language_versions
model LanguageVersion {
  id           String   @id @default(uuid())
  languageId   String
  language     Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  version      String
  compiler     String
  buildCommand String?
  runCommand   String
  isDefault    Boolean  @default(false)

  @@unique([languageId, version])
}

// 8. executions
model Execution {
  id             String          @id @default(uuid())
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId         String?
  language       String
  status         ExecutionStatus
  exitCode       Int
  executionTimeMs Int
  memoryUsageMb  Int
  createdAt      DateTime        @default(now())

  logs           ExecutionLog[]

  @@index([language])
  @@index([status])
  @@index([createdAt])
}

// 9. execution_logs
model ExecutionLog {
  id           String    @id @default(uuid())
  executionId  String
  execution    Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stdout       String?   @db.Text
  stderr       String?   @db.Text
  stdin        String?   @db.Text
}

// 10. test_cases
model TestCase {
  id             String     @id @default(uuid())
  challengeId    String?
  challenge      Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  name           String
  stdin          String     @db.Text
  expectedStdout String     @db.Text
  isHidden       Boolean    @default(false)
  timeLimitMs    Int        @default(2000)
  memoryLimitMb  Int        @default(128)
}

// 11. challenges
model Challenge {
  id             String              @id @default(uuid())
  title          String
  slug           String              @unique
  difficulty     ChallengeDifficulty
  category       String
  description    String              @db.Text
  constraints    String[]
  starterCode    Json
  acceptanceRate Float               @default(0.0)
  createdAt      DateTime            @default(now())

  testCases      TestCase[]
  submissions    Submission[]

  @@index([difficulty])
  @@index([category])
}

// 12. submissions
model Submission {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId    String
  challenge      Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  language       String
  code           String             @db.Text
  verdict        SubmissionVerdict
  timeMs         Int
  memoryMb       Int
  testsPassed    Int
  testsTotal     Int
  submittedAt    DateTime           @default(now())

  @@index([userId])
  @@index([challengeId])
  @@index([verdict])
}

// 13. courses
model Course {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  level       String
  language    String
  lessons     Lesson[]
  createdAt   DateTime @default(now())
}

// 14. lessons
model Lesson {
  id           String         @id @default(uuid())
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  orderIndex   Int
  content      String         @db.Text
  starterCode  String         @db.Text
  expectedOut  String         @db.Text
  progress     UserProgress[]

  @@unique([courseId, slug])
}

// 15. user_progress
model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean  @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

// 16. ai_requests
model AIRequest {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestType  String   // explain, autofix, optimize, convert
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  wasApplied   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

// 17. shared_links
model SharedLink {
  id         String   @id @default(uuid())
  token      String   @unique
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isPublic   Boolean  @default(true)
  expiresAt  DateTime?
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([token])
}

// 18. deployments
model Deployment {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployUrl    String
  status       String   // building, live, failed, stopped
  buildLogs    String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([projectId])
}

// 19. environments
model Environment {
  id           String   @id @default(uuid())
  name         String
  runtimeImage String
  cpuCores     Float    @default(1.0)
  memoryMb     Int      @default(512)
  isCustom     Boolean  @default(false)
}

// 20. dependencies
model Dependency {
  id          String   @id @default(uuid())
  ecosystem   String   // npm, pip, cargo, maven
  name        String
  version     String
  isVerified  Boolean  @default(true)

  @@unique([ecosystem, name, version])
}

// 21. api_keys
model ApiKey {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash     String     @unique
  name        String
  rateLimit   Int        @default(60) // requests per minute
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  lastUsedAt  DateTime?

  usageLogs   ApiUsage[]

  @@index([keyHash])
}

// 22. api_usage
model ApiUsage {
  id         String   @id @default(uuid())
  apiKeyId   String
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint   String
  statusCode Int
  timestamp  DateTime @default(now())

  @@index([apiKeyId, timestamp])
}

// 23. notifications
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// 24. audit_logs
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  ipAddress String?
  details   Json?
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([action])
}
