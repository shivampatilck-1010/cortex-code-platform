{
  "name": "cortex-code-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "node ./scripts/run-dev.mjs",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start -p 3000 -H 0.0.0.0",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/tsx/dist/cli.mjs tests/run-e2e.ts",
    "test:e2e": "node ./node_modules/tsx/dist/cli.mjs tests/run-e2e.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:staging": "node scripts/deploy-staging.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/katex": "^0.16.8",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "diff": "^5.2.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.13.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.400.0",
    "monaco-editor": "^0.49.0",
    "next": "^15.2.0",
    "nodemailer": "^10.0.0",
    "ogl": "^1.0.11",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "^2.4.0",
    "three": "^0.187.0",
    "vinext": "^1.0.0-beta.9",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/diff": "^5.2.1",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vite": "^8.2.2",
    "wrangler": "^4.131.1"
  },
  "type": "module"
}
