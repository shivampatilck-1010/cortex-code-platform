# ==============================================================================
# CORTEX LOCKDOWN — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Milestone: Release Candidate 1.2 / Production Release Gate
# Target Platform: Windows 10/11 x64 (Campus Lab Testbeds & Managed Staging)
# Strictly Zero Emojis Enforced. Additional Budget: INR 0.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
PORT=3000
HOST=127.0.0.1
NEXT_PUBLIC_APP_URL=https://cortex.university.edu

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS (MANDATORY SERVER-SIDE — NEVER COMMIT ACTUAL SECRETS)
# Generate 64-character hex strings: openssl rand -hex 32
# ------------------------------------------------------------------------------
# Primary session cookie signing secret
CORTEX_SESSION_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY

# Launch grant HMAC-SHA256 signing secret (120-second TTL token)
LOCKDOWN_LAUNCH_GRANT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY

# Audit checkpoint HMAC-SHA256 secret (active key in keyring)
LOCKDOWN_AUDIT_CHECKPOINT_KEY_ID=k2026_prod_01
LOCKDOWN_AUDIT_CHECKPOINT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY

# Operational monitoring and health diagnostics probe secret
CORTEX_MONITORING_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_KEY

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION & PATHS
# Qualified Engine: SQLite 3 with Write-Ahead Logging (WAL)
# ------------------------------------------------------------------------------
DATABASE_PROVIDER=sqlite
DATABASE_SQLITE_PATH=data/cortex-production.sqlite
DATABASE_SQLITE_BUSY_TIMEOUT_MS=5000
DATABASE_SQLITE_WAL_MODE=true

# Cloudflare D1 (NOT TESTED for high-concurrency production lockdown)
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

# PostgreSQL (Architecture only; unverified in INR 0 evaluation)
# DATABASE_POSTGRES_URL=

# ------------------------------------------------------------------------------
# 4. HTTPS, COOKIE SECURITY & CORS
# ------------------------------------------------------------------------------
FORCE_HTTPS=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
CORS_ALLOWED_ORIGINS=https://cortex.university.edu

# ------------------------------------------------------------------------------
# 5. OUTBOUND HTTP & SSRF DEFENSE CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'true' to strictly enforce WHATWG URL parsing and private IP rejection
LOCKDOWN_SSRF_ENFORCEMENT=true
LOCKDOWN_JWKS_FETCH_TIMEOUT_MS=5000
LOCKDOWN_JWKS_MAX_RESPONSE_BYTES=524288

# Dedicated Forward Proxy (Required for socket-level DNS pinning in zero-trust setups)
# HTTP_PROXY=http://proxy.university.edu:8080
# HTTPS_PROXY=http://proxy.university.edu:8080
# NO_PROXY=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 6. PROTOCOL INTEROPERABILITY (LTI 1.3 ADVANTAGE & SAML 2.0)
# ------------------------------------------------------------------------------
# LTI 1.3 Advantage Core Configuration (PILOT QUALIFIED)
LTI_ISSUER_ALLOWLIST=https://canvas.instructure.com,https://blackboard.university.edu,https://moodle.university.edu
LTI_NONCE_TTL_SECONDS=600

# SAML 2.0 Web SSO (PRODUCTION FEDERATION BLOCKED due to non-W3C Exc-C14N)
SAML_PRODUCTION_FEDERATION_ENABLED=false
SAML_RESTRICTED_C14N_ONLY=true

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & SECURITY THROTTLING
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX_PER_MINUTE=10
RATE_LIMIT_EMERGENCY_EXIT_PER_PROCTOR_10MIN=10
RATE_LIMIT_EMERGENCY_EXIT_PER_CANDIDATE_1MIN=5
RATE_LIMIT_SYNC_ANSWERS_MAX_PER_MINUTE=60
RATE_LIMIT_TELEMETRY_MAX_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 8. PRIVACY & DATA RETENTION POLICIES
# ------------------------------------------------------------------------------
PRIVACY_IN_MEMORY_PROCTORING_ONLY=true
PRIVACY_ZERO_MEDIA_PERSISTENCE=true
PRIVACY_RETENTION_DEFAULT_DAYS=90
PRIVACY_DISPUTE_FREEZE_ENABLED=true
