# Cortex Universal Code Platform - Environment Configuration

# Core Runtime Environment ('development' | 'staging' | 'production')
APP_ENV=development

# Session and Authentication Secret
CORTEX_SESSION_SECRET=

# Cortex Lockdown Security Policy HMAC Secret (Required in production)
LOCKDOWN_POLICY_SECRET=

# Cortex Lockdown Server Cryptographic Pepper for Recovery OTP Digests (Required in production)
LOCKDOWN_SERVER_PEPPER=

# Safe Exam Browser (SEB) Single-Use Launch Token Cryptographic Secret (Required in production)
SEB_LAUNCH_TOKEN_SECRET=

# Optional: Comma-separated list of additional trusted institutional hostnames for SEB reverse-proxy verification (e.g. exams.university.edu)
SEB_TRUSTED_HOSTS=

# LTI 1.3 Institutional Integration HMAC-SHA256 Secret (Required in production)
LTI_HMAC_SECRET=

# GitHub OAuth Application Credentials (Required in production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Google Gemini API Key for AI-assisted Code Analysis and Auto-repair
GEMINI_API_KEY=
