# Cortex Cloud Platform - Environment Configuration Example
# Copy this file to .env.local to customize your deployment

# Google Gemini API Key (Optional - Users can also connect their free key directly in the UI)
GEMINI_API_KEY=

# Canonical Production URL (for OpenGraph & SEO rich schemas)
NEXT_PUBLIC_APP_URL=https://cortexcode.io

# Email & Webhook Dispatch for Error/Feedback Reports (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FEEDBACK_RECIPIENT_EMAIL=support@cortexcode.io
FEEDBACK_WEBHOOK_URL=
